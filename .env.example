# Copy to .env and fill in from the onboarding (docs/onboarding-sandbox.md).
# .env is git-ignored. Private keys belong in a secret manager, not here — this
# file exists so a Sandbox demo can be stood up, not as a deployment pattern.

# ---------------------------------------------------------------- application
SWIYU_MODE=sandbox
PORT=3000

# Trust policy applied to every presentation.
#   sandbox — keeps the profile's MUST rules, records the SHOULDs as waived.
#             Correct for the Sandbox, where actors have no identity onboarding.
#   strict  — enforces the SHOULDs too. Use this in production and mean it.
SWIYU_TRUST_POLICY=sandbox

# DID accepted as the Beta-ID issuer. Defaults to the Beta Credential Service,
# so this only needs setting if you issue your own identity credential.
# BETA_ID_ISSUER_DID=

# ------------------------------------------------------ Sandbox environment
# Note `swiyu-int`: these are the Sandbox hosts. Production uses the equivalent
# `swiyu` hosts, and CD-001 forbids mixing the two.
SWIYU_STATUS_REGISTRY_TOKEN_URL=https://keymanager-prd.api.admin.ch/keycloak/realms/APIGW/protocol/openid-connect
SWIYU_STATUS_REGISTRY_API_URL=https://status-reg-api.trust-infra.swiyu-int.admin.ch
SWIYU_TRUST_REGISTRY_URL=https://trust-reg.trust-infra.swiyu-int.admin.ch

# ------------------------------------------------------------------- insurer
# https URL the wallet can reach. The wallet refuses plain http.
INSURER_EXTERNAL_URL=https://insurer.example.ch
INSURER_DID=did:webvh:<scid>:identifier-reg.trust-infra.swiyu-int.admin.ch:api:v1:did:<uuid>
INSURER_SDJWT_VERIFICATION_METHOD=${INSURER_DID}#assert-key-01
INSURER_SDJWT_KEY=
INSURER_STATUS_LIST_VERIFICATION_METHOD=${INSURER_DID}#assert-key-02
INSURER_STATUS_LIST_KEY=
INSURER_PARTNER_ID=
INSURER_STATUS_REGISTRY_CUSTOMER_KEY=
INSURER_STATUS_REGISTRY_CUSTOMER_SECRET=
INSURER_STATUS_REGISTRY_ACCESS_TOKEN=
INSURER_STATUS_REGISTRY_REFRESH_TOKEN=
INSURER_DB_PASSWORD=change-me

# -------------------------------------------------------------------- praxis
# Issues immunization records, laboratory reports and prescriptions, and
# verifies at check-in — so it needs both an issuer and a verifier instance.
PRAXIS_EXTERNAL_URL=https://praxis.example.ch
PRAXIS_VERIFIER_EXTERNAL_URL=https://praxis-verify.example.ch
PRAXIS_DID=did:webvh:<scid>:identifier-reg.trust-infra.swiyu-int.admin.ch:api:v1:did:<uuid>
PRAXIS_SDJWT_VERIFICATION_METHOD=${PRAXIS_DID}#assert-key-01
PRAXIS_SDJWT_KEY=
PRAXIS_STATUS_LIST_VERIFICATION_METHOD=${PRAXIS_DID}#assert-key-02
PRAXIS_STATUS_LIST_KEY=
# The verifier signs the JAR with an authentication key, not an assertion key.
PRAXIS_AUTH_VERIFICATION_METHOD=${PRAXIS_DID}#auth-key-01
PRAXIS_AUTH_KEY=
PRAXIS_PARTNER_ID=
PRAXIS_STATUS_REGISTRY_CUSTOMER_KEY=
PRAXIS_STATUS_REGISTRY_CUSTOMER_SECRET=
PRAXIS_STATUS_REGISTRY_ACCESS_TOKEN=
PRAXIS_STATUS_REGISTRY_REFRESH_TOKEN=
PRAXIS_DB_PASSWORD=change-me

# ------------------------------------------------------------------ pharmacy
PHARMACY_EXTERNAL_URL=https://pharmacy.example.ch
PHARMACY_DID=did:webvh:<scid>:identifier-reg.trust-infra.swiyu-int.admin.ch:api:v1:did:<uuid>
PHARMACY_AUTH_VERIFICATION_METHOD=${PHARMACY_DID}#auth-key-01
PHARMACY_AUTH_KEY=
PHARMACY_DB_PASSWORD=change-me

# ------------------------------------------------------------- travel clinic
TRAVEL_CLINIC_EXTERNAL_URL=https://travel.example.ch
TRAVEL_CLINIC_DID=did:webvh:<scid>:identifier-reg.trust-infra.swiyu-int.admin.ch:api:v1:did:<uuid>
TRAVEL_CLINIC_AUTH_VERIFICATION_METHOD=${TRAVEL_CLINIC_DID}#auth-key-01
TRAVEL_CLINIC_AUTH_KEY=
TRAVEL_CLINIC_DB_PASSWORD=change-me
