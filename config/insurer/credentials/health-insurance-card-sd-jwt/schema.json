{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://localhost:8080/oid4vci/json-schema/health-insurance-card-sd-jwt",
  "title": "Swiss Health Insurance Card",
  "type": "object",
  "properties": {
    "given_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "title": "Given name(s)"
    },
    "family_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "title": "Surname"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "title": "Date of birth"
    },
    "card_number": {
      "type": "string",
      "pattern": "^807[0-9]{17}$",
      "title": "Card number"
    },
    "personal_administrative_number": {
      "type": "string",
      "pattern": "^756\\.[0-9]{4}\\.[0-9]{4}\\.[0-9]{2}$",
      "title": "Social security number"
    },
    "insurer_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "title": "Insurer"
    },
    "insurer_bag_number": {
      "type": "string",
      "pattern": "^[0-9]{4,5}$",
      "title": "Insurer registration number"
    },
    "insurance_model": {
      "type": "string",
      "enum": [
        "STANDARD",
        "HMO",
        "HAUSARZT",
        "TELMED"
      ],
      "title": "Model"
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "KVG",
          "VVG",
          "UVG"
        ]
      },
      "title": "Coverage"
    },
    "valid_from": {
      "type": "string",
      "format": "date",
      "title": "Valid from"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "title": "Valid until"
    }
  },
  "required": [
    "given_name",
    "family_name",
    "birth_date",
    "card_number",
    "personal_administrative_number",
    "insurer_name",
    "insurer_bag_number",
    "insurance_model",
    "coverage",
    "valid_from",
    "expiry_date"
  ],
  "additionalProperties": false
}
