{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://localhost:8081/oid4vci/json-schema/health-immunization-sd-jwt",
  "title": "Immunization Record",
  "type": "object",
  "properties": {
    "immunization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "title": "Record number"
    },
    "patient_given_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "title": "Given name(s)"
    },
    "patient_family_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "title": "Surname"
    },
    "patient_birth_date": {
      "type": "string",
      "format": "date",
      "title": "Date of birth"
    },
    "vaccine_code": {
      "type": "string",
      "pattern": "^[0-9]{6,18}$",
      "title": "Vaccine code"
    },
    "vaccine_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "title": "Vaccine"
    },
    "target_disease": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "title": "Protects against"
    },
    "occurrence_date": {
      "type": "string",
      "format": "date",
      "title": "Date given"
    },
    "dose_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "title": "Dose number"
    },
    "doses_in_series": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "title": "Doses in series"
    },
    "next_dose_due": {
      "type": "string",
      "format": "date",
      "title": "Next dose due"
    },
    "lot_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "title": "Lot number"
    },
    "route": {
      "type": "string",
      "enum": [
        "IM",
        "SC",
        "ID",
        "PO",
        "NASINHL"
      ],
      "title": "Route"
    },
    "site": {
      "type": "string",
      "maxLength": 100,
      "title": "Site"
    },
    "performer_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "title": "Administered by"
    },
    "performer_gln": {
      "type": "string",
      "pattern": "^[0-9]{13}$",
      "title": "GLN"
    },
    "organization_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "title": "Location"
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "title": "Country"
    }
  },
  "required": [
    "immunization_id",
    "patient_given_name",
    "patient_family_name",
    "patient_birth_date",
    "vaccine_code",
    "vaccine_name",
    "target_disease",
    "occurrence_date",
    "dose_number",
    "doses_in_series",
    "lot_number",
    "route",
    "performer_name",
    "performer_gln",
    "organization_name",
    "country"
  ],
  "additionalProperties": false
}
