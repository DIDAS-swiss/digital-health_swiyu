{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://localhost:8081/oid4vci/json-schema/health-prescription-sd-jwt",
  "title": "Swiss Electronic Prescription",
  "type": "object",
  "properties": {
    "prescription_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "title": "Prescription number"
    },
    "patient_given_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "title": "Given name(s)"
    },
    "patient_family_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "title": "Surname"
    },
    "patient_birth_date": {
      "type": "string",
      "format": "date",
      "title": "Date of birth"
    },
    "medication": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "gtin": {
            "type": "string",
            "pattern": "^[0-9]{13,14}$"
          },
          "dosage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "substitution_allowed": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "dosage",
          "quantity",
          "substitution_allowed"
        ],
        "additionalProperties": false
      }
    },
    "prescriber_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "title": "Prescriber"
    },
    "prescriber_gln": {
      "type": "string",
      "pattern": "^[0-9]{13}$",
      "title": "GLN"
    },
    "issued_date": {
      "type": "string",
      "format": "date",
      "title": "Date of issue"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "title": "Valid until"
    },
    "repeats_authorized": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12,
      "title": "Repeats"
    }
  },
  "required": [
    "prescription_id",
    "patient_given_name",
    "patient_family_name",
    "patient_birth_date",
    "medication",
    "prescriber_name",
    "prescriber_gln",
    "issued_date",
    "expiry_date",
    "repeats_authorized"
  ],
  "additionalProperties": false
}
