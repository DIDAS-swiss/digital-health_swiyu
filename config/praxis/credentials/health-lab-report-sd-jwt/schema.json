{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://localhost:8081/oid4vci/json-schema/health-lab-report-sd-jwt",
  "title": "Laboratory Report",
  "type": "object",
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "title": "Report number"
    },
    "patient_given_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "title": "Given name(s)"
    },
    "patient_family_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "title": "Surname"
    },
    "patient_birth_date": {
      "type": "string",
      "format": "date",
      "title": "Date of birth"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "loinc_code": {
            "type": "string",
            "pattern": "^[0-9]{1,5}-[0-9]$"
          },
          "analyte": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "unit": {
            "type": "string",
            "maxLength": 50
          },
          "reference_range": {
            "type": "string",
            "maxLength": 100
          },
          "flag": {
            "type": "string",
            "enum": [
              "NORMAL",
              "LOW",
              "HIGH",
              "CRITICAL"
            ]
          }
        },
        "required": [
          "loinc_code",
          "analyte",
          "value",
          "unit",
          "reference_range",
          "flag"
        ],
        "additionalProperties": false
      }
    },
    "interpretation": {
      "type": "string",
      "maxLength": 2000,
      "title": "Assessment"
    },
    "specimen_date": {
      "type": "string",
      "format": "date",
      "title": "Specimen date"
    },
    "report_date": {
      "type": "string",
      "format": "date",
      "title": "Report date"
    },
    "laboratory_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "title": "Laboratory"
    },
    "ordering_physician_gln": {
      "type": "string",
      "pattern": "^[0-9]{13}$",
      "title": "Ordering physician GLN"
    }
  },
  "required": [
    "report_id",
    "patient_given_name",
    "patient_family_name",
    "patient_birth_date",
    "findings",
    "specimen_date",
    "report_date",
    "laboratory_name",
    "ordering_physician_gln"
  ],
  "additionalProperties": false
}
